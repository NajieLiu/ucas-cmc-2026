digraph G {
  bgcolor="white";
  graph [ranksep=0.45, nodesep=0.4];
  node [fontname="Microsoft YaHei", fontsize=15, shape=box, style="rounded,filled",
        penwidth=1.5, margin="0.13,0.08", fillcolor="white"];
  edge [penwidth=1.4, color="#5f6368", arrowsize=0.75];

  root [label="微分中值定理与证明", fillcolor="#3949ab", fontcolor="white", color="#283593",
        fontsize=19, penwidth=2.2];

  c1 [label="中值定理家族", fillcolor="#e3f2fd", color="#1976d2", fontsize=16];
  c2 [label="构造四板斧", fillcolor="#e8f5e9", color="#2e7d32", fontsize=16];
  c3 [label="不等式证明", fillcolor="#fff3e0", color="#e65100", fontsize=16];
  c4 [label="零点/最值", fillcolor="#f3e5f5", color="#6a1b9a", fontsize=16];

  a1 [label="罗尔 Rolle", color="#1976d2", fontsize=14];
  a2 [label="拉格朗日", color="#1976d2", fontsize=14];
  a3 [label="柯西", color="#1976d2", fontsize=14];
  a4 [label="泰勒 Taylor", color="#1976d2", fontsize=14];

  b1 [label="原函数法\n（解 y'+py=0）", color="#2e7d32", fontsize=14];
  b2 [label="常数 k 值法\n（F=f-kx）", color="#2e7d32", fontsize=14];
  b3 [label="双中值点\n（分点先行）", color="#2e7d32", fontsize=14];
  b4 [label="Taylor 展开\n（端点/中点）", color="#2e7d32", fontsize=14];

  d1 [label="作差+单调性\n（符号接力）", color="#e65100", fontsize=14];
  d2 [label="中值放缩\n（|f'|控制）", color="#e65100", fontsize=14];
  d3 [label="Taylor 余项\n（端点展开相减）", color="#e65100", fontsize=14];

  e1 [label="\"至少\"：介值", color="#6a1b9a", fontsize=14];
  e2 [label="\"至多\"：严格单调", color="#6a1b9a", fontsize=14];
  e3 [label="偶函数：减半", color="#6a1b9a", fontsize=14];
  e4 [label="配方法：取特殊点", color="#6a1b9a", fontsize=14];

  note [label="※ 所有板斧的最后一步都是同一个动作：\n在 [a,b] 上用 Rolle —— F(a)=F(b) → F'(ξ)=0",
        fillcolor="#f5f5f5", color="#616161", fontsize=13];

  root -> c1; root -> c2; root -> c3; root -> c4;

  c1 -> a1; a1 -> a2; a2 -> a3; a3 -> a4;
  c2 -> b1; b1 -> b2; b2 -> b3; b3 -> b4;
  c3 -> d1; d1 -> d2; d2 -> d3;
  c4 -> e1; e1 -> e2; e2 -> e3; e3 -> e4;

  // 底部注块：置于最底，用不可见边定位（不画箭头）
  { rank=sink; note; }
  { edge [style=invis]; a4 -> note; d3 -> note; e4 -> note; }

  // 配对箭头（虚线横边，不影响主树布局）
  edge [style=dashed, constraint=false, color="#9e9e9e"];
  a1 -> b1; a2 -> b2; a3 -> b3; a4 -> b4;
}
