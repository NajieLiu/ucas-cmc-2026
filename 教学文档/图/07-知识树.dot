digraph G {
  bgcolor="white";
  graph [ranksep=0.45, nodesep=0.22];
  node [fontname="Microsoft YaHei", fontsize=15, shape=box, style="rounded,filled", penwidth=1.5, margin="0.13,0.08", fillcolor="white"];
  edge [penwidth=1.4, color="#5f6368", arrowsize=0.75];

  root [label="常微分方程（未知量是函数）", fillcolor="#3949ab", fontcolor="white", color="#283593", fontsize=19, penwidth=2.2];

  b1 [label="一阶方程\n（六种解法）", fillcolor="#e3f2fd", color="#1976d2", fontsize=16];
  b2 [label="二阶常系数线性\n（公式化，零失误目标）", fillcolor="#e8f5e9", color="#2e7d32", fontsize=16];
  b3 [label="高阶 / 特殊型\n（降阶、欧拉）", fillcolor="#fff3e0", color="#e65100", fontsize=16];

  a1 [label="可分离", color="#1976d2", fontsize=14];
  a2 [label="线性\n公式必背", color="#1976d2", fontsize=14];
  a3 [label="伯努利\nz=y^(1-n)", color="#1976d2", fontsize=14];

  n1 [label="齐次（u=y/x）· 平移化齐次\n· 凑微分四大恒等式\n· 不变量换元（竞赛真身）", color="#616161", fillcolor="#f5f5f5", fontsize=13];

  g1 [label="齐次部分\n（特征方程）\n三情形通解表", color="#2e7d32", fontsize=14];
  g2 [label="非齐次部分\n（待定系数法）\nλ 重数 × x^k", color="#2e7d32", fontsize=14];

  cc [label="y''=f(x)：逐次积分\ny''=f(y,y')：令 p=y'\nx=e^t（欧拉方程）", color="#e65100", fontsize=14];

  d1 [label="隐藏型三接头：积分恒等式求导\n/ 路径无关 / 偏导条件", color="#616161", fillcolor="#f5f5f5", fontsize=13];
  d2 [label="证明型：解出通解\n→ 逐项估计有界（13 届）\n／夹逼 + 反证（11 届）", color="#616161", fillcolor="#f5f5f5", fontsize=13];

  root -> b1; root -> b2; root -> b3;
  b1 -> a1; b1 -> a2; b1 -> a3;
  b2 -> g1; b2 -> g2;
  b3 -> cc;

  // 一阶横链注（原文 └── 横线）：注解线用灰色虚线，仅 a2 保留布局约束
  a1 -> n1 [style=dashed, color="#9e9e9e", arrowsize=0.55, constraint=false];
  a2 -> n1 [style=dashed, color="#9e9e9e", arrowsize=0.55];
  a3 -> n1 [style=dashed, color="#9e9e9e", arrowsize=0.55, constraint=false];

  // 底部两条链（原文竖向接力线）
  n1 -> d1; d1 -> d2;
}
