digraph G {
  bgcolor="white";
  graph [ranksep=0.32, nodesep=0.25];
  node [fontname="Microsoft YaHei", fontsize=15, shape=box, style="rounded,filled", penwidth=1.5, margin="0.13,0.06", fillcolor="white"];
  edge [penwidth=1.4, color="#5f6368", arrowsize=0.75];

  root [label="向量代数与空间解析几何", fillcolor="#3949ab", fontcolor="white", color="#283593", fontsize=19, penwidth=2.2];

  // 三支（每支一色）
  b1 [label="向量三积\n（底层工具）", fillcolor="#e3f2fd", color="#1976d2", fontsize=16];
  b2 [label="平面与直线", fillcolor="#e8f5e9", color="#2e7d32", fontsize=16];
  b3 [label="曲面与曲线", fillcolor="#fff3e0", color="#e65100", fontsize=16];

  // 向量三积（蓝）
  v1 [label="数量积\n(夹角/垂直)", color="#1976d2", fontsize=14];
  v2 [label="向量积\n(面积/平行)", color="#1976d2", fontsize=14];
  v3 [label="混合积\n(体积/共面)", color="#1976d2", fontsize=14];

  // 平面与直线（绿）
  p1 [label="平面：点法式/一般式\n+ 平面束(过交线)", color="#2e7d32", fontsize=14];
  l1 [label="直线：对称式/参数式\n/一般式(交线)", color="#2e7d32", fontsize=14];
  d0 [label="方向向量 s=n₁×n₂", color="#2e7d32", fontsize=14];
  a1 [label="夹角与距离公式表", color="#2e7d32", fontsize=14];

  // 曲面与曲线（橙）
  t1 [label="切平面：∇F 是法向量", color="#e65100", fontsize=14];
  t2 [label="相切：∇F=λ∇G", color="#e65100", fontsize=14];
  c1 [label="柱面：缺变量", color="#e65100", fontsize=14];
  r1 [label="旋转面：替换口诀", color="#e65100", fontsize=14];
  k1 [label="圆锥面：等角/准线法", color="#e65100", fontsize=14];
  q1 [label="二次曲面：识别表+截痕", color="#e65100", fontsize=14];
  s1 [label="空间曲线：参数化\n(积分入口)", color="#e65100", fontsize=14];

  // 底部汇合（玫红重点框）
  m0 [label="投影三件套：点投影/\n投影直线/投影曲线(消元)", fillcolor="#fce4ec", color="#ad1457", fontsize=15];

  root -> b1; root -> b2; root -> b3;

  b1 -> v1; v1 -> v2; v2 -> v3;
  b2 -> p1; p1 -> l1; l1 -> d0; d0 -> a1;
  b3 -> t1; t1 -> t2; t2 -> c1; c1 -> r1; r1 -> k1; k1 -> q1; q1 -> s1;

  { rank=same; a1; s1; }
  a1 -> m0; s1 -> m0;

  // 横向关系：向量三积 ── 配合使用 ── 平面与直线的方向向量
  lbl [label="配合使用", fillcolor="#f5f5f5", color="#616161", fontsize=13];
  { rank=same; v3; lbl; d0; }
  v3 -> lbl [style=dashed, color="#9e9e9e", dir=none];
  lbl -> d0 [style=dashed, color="#9e9e9e", dir=none];
}
